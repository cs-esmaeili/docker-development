# Shared infra settings. Used by global/docker-compose.yml and bin/*.

COMPOSE_PROJECT_NAME=infra

# PHP CLI image (8.1 | 8.2 | 8.3 | 8.4 | ...). Default for bare `php`.
PHP_VERSION=8.4


MYSQL_PORT=3306
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes

REDIS_PORT=6370
REDISINSIGHT_PORT=4003
# redis/redisinsight tag; 3.8 is the current 3.x line
REDISINSIGHT_VERSION=3.8

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# pgAdmin (web UI for postgres)
PGADMIN_PORT=4002
PGADMIN_VERSION=9.19
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin

MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=mongo

PMA_PORT=4001

# Infra dashboard (web overview of services/ports; reads this file)
DASHBOARD_PORT=4000
